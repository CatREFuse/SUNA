{
  "name": "sandbook",
  "productName": "沙之书",
  "version": "0.4.1-alpha",
  "private": true,
  "type": "module",
  "main": "desktop/main.mjs",
  "description": "多角色对话与渠道集成桌面应用",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite --host 127.0.0.1 --port 4260",
    "dev:api": "node src/server.mjs",
    "build": "vue-tsc --noEmit && vite build",
    "typecheck": "vue-tsc --noEmit",
    "start": "electron .",
    "package": "node scripts/package-app.mjs",
    "package:channels": "node scripts/package-channels.mjs release/plugins"
  },
  "dependencies": {
    "@boxicons/vue": "1.0.1",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/noto-sans-sc": "5.3.1",
    "@jannchie/pixi-live2d-display": "^1.4.0",
    "@lucide/vue": "^1.64.0",
    "@pixiv/three-vrm": "3.4.4",
    "@types/qrcode": "^1.5.5",
    "markdown-it": "15.0.3",
    "pixi.js": "^8.22.0",
    "qrcode": "^1.5.4",
    "sharp": "0.35.5",
    "three": "0.185.1",
    "vue": "3.5.44"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "@types/node": "^24.10.0",
    "@types/three": "0.185.4",
    "@vitejs/plugin-vue": "6.0.8",
    "electron": "45.1.0",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vue-tsc": "3.1.0"
  }
}
